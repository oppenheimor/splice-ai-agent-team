{
  "name": "agent-team",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "dev:init": "bash scripts/dev-init.sh",
    "build": "eve build && next build",
    "start": "next start",
    "test:wish-creator": "node --test lib/wish-creator/*.test.ts",
    "test:deploy": "bash tests/deploy-production-config.test.sh && bash tests/deploy-from-volcengine.test.sh && bash tests/deploy-production-nginx-reload.test.sh && bash tests/deploy-production-image-retention.test.sh",
    "test:wish-intake": "node --test lib/wish-intake/*.test.ts",
    "test:wish-intake:e2e": "node --env-file=.env --env-file=.env.local scripts/test-wish-intake-flow.mjs",
    "test:agent-conversations": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/test-agent-conversation-concurrency.mjs",
    "typecheck": "tsc --noEmit",
    "eve:build": "eve build",
    "eve:start": "eve start",
    "lint": "eslint",
    "eval:export": "node scripts/export-agent-eval-cases.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "3.0.11",
    "@ai-sdk/react": "4.0.30",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "ai": "7.0.28",
    "animal-island-ui": "^0.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "eve": "0.24.3",
    "geist": "^1.7.2",
    "just-bash": "3.1.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3"
  }
}
