generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String                 @id @default(cuid())
  username        String                 @unique
  passwordHash    String
  phone           String?                @unique
  name            String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  sessions        Session[]
  analyticsEvents TreasureAnalyticsEvent[]
  chatMessages    TreasureChatMessage[]
  diagnosisResults DiagnosisQuizResult[]
  diagnosisChatSessions DiagnosisChatSession[]
  diagnosisChatMessages DiagnosisChatMessage[]
  agentConversations AgentConversation[]
  agentMessages      AgentMessage[]
  agentRuns          AgentRun[]
  creditAccount      CreditAccount?
  creditLedgerEntries CreditLedgerEntry[]
  agentUsageRecords  AgentUsageRecord[]

  @@map("users")
}

model DiagnosisQuizResult {
  id                String                 @id @default(cuid())
  userId            String                 @map("user_id")
  answers           Json
  dimensionScores   Json                   @map("dimension_scores")
  operatorCode      String                 @map("operator_code")
  operatorTypeName  String                 @map("operator_type_name")
  aiAdoptionStage   String                 @map("ai_adoption_stage")
  userType          String                 @map("user_type")
  cognitiveWidth    String                 @map("cognitive_width")
  blindSpots        Json                   @map("blind_spots")
  justNeed          String                 @map("just_need")
  crowdType         String                 @map("crowd_type")
  enhancedNarrative Json?                  @map("enhanced_narrative")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession       DiagnosisChatSession?

  @@index([userId, createdAt])
  @@map("diagnosis_quiz_results")
}

model DiagnosisChatSession {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  quizResultId  String              @unique @map("quiz_result_id")
  conversationId String?            @unique @map("conversation_id")
  status        String              @default("active")
  lastMessageAt DateTime            @default(now()) @map("last_message_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizResult    DiagnosisQuizResult @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
  messages      DiagnosisChatMessage[]

  @@index([userId, lastMessageAt])
  @@map("diagnosis_chat_sessions")
}

model DiagnosisChatMessage {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  chatSessionId  String   @map("chat_session_id")
  conversationId String   @map("conversation_id")
  messageId      String   @map("message_id")
  role           String
  text           String?
  parts          Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSession    DiagnosisChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([userId, createdAt])
  @@index([chatSessionId, createdAt])
  @@index([conversationId, createdAt])
  @@map("diagnosis_chat_messages")
}

model Session {
  id        String    @id
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String    @map("code")
  ipAddress  String?   @map("ip_address")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([phone, createdAt])
  @@index([ipAddress, createdAt])
  @@index([expiresAt])
  @@map("verification_codes")
}

model SmsSendLog {
  id        String   @id @default(cuid())
  phone     String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@index([ipAddress, createdAt])
  @@map("sms_send_logs")
}

model TreasureAnalyticsEvent {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String?
  visitorId      String?
  conversationId String?
  type           String
  pagePath       String
  target         String?
  payload        Json?
  userAgent      String?
  ipAddress      String?
  occurredAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([type, occurredAt])
  @@index([userId, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([conversationId, occurredAt])
  @@map("treasure_analytics_events")
}

model TreasureChatMessage {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String?
  visitorId      String?
  conversationId String
  messageId      String
  role           String
  text           String?
  parts          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([visitorId, createdAt])
  @@index([conversationId, createdAt])
  @@map("treasure_chat_messages")
}

model AgentConversation {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  sessionId      String?        @map("session_id")
  visitorId      String?        @map("visitor_id")
  conversationId String         @unique @map("conversation_id")
  agentId        String         @map("agent_id")
  agentVersion   String?        @map("agent_version")
  promptVersion  String?        @map("prompt_version")
  model          String?
  title          String?
  status         String         @default("active")
  firstUserText  String?        @map("first_user_text")
  metadata       Json?
  lastMessageAt  DateTime       @default(now()) @map("last_message_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AgentMessage[]
  runs           AgentRun[]

  @@index([userId, lastMessageAt])
  @@index([agentId, lastMessageAt])
  @@index([sessionId, lastMessageAt])
  @@index([visitorId, lastMessageAt])
  @@map("agent_conversations")
}

model AgentMessage {
  id                  String            @id @default(cuid())
  userId              String            @map("user_id")
  agentConversationId String            @map("agent_conversation_id")
  conversationId      String            @map("conversation_id")
  agentId             String            @map("agent_id")
  messageId           String            @map("message_id")
  messageIndex        Int               @default(0) @map("message_index")
  role                String
  text                String?
  parts               Json?
  metadata            Json?
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation        AgentConversation @relation(fields: [agentConversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([agentConversationId, createdAt])
  @@index([conversationId, messageIndex])
  @@index([conversationId, createdAt])
  @@map("agent_messages")
}

model AgentRun {
  id                  String            @id @default(cuid())
  userId              String            @map("user_id")
  agentConversationId String            @map("agent_conversation_id")
  conversationId      String            @map("conversation_id")
  agentId             String            @map("agent_id")
  agentVersion        String?           @map("agent_version")
  promptVersion       String?           @map("prompt_version")
  model               String?
  status              String            @default("started")
  inputMessageCount   Int               @default(0) @map("input_message_count")
  outputMessageCount  Int               @default(0) @map("output_message_count")
  latencyMs           Int?              @map("latency_ms")
  errorMessage        String?           @map("error_message")
  decision            Json?
  metadata            Json?
  startedAt           DateTime          @default(now()) @map("started_at")
  finishedAt          DateTime?         @map("finished_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation        AgentConversation @relation(fields: [agentConversationId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([agentId, startedAt])
  @@index([conversationId, startedAt])
  @@index([status, startedAt])
  @@map("agent_runs")
}

model CreditAccount {
  id             String              @id @default(cuid())
  userId         String              @unique @map("user_id")
  balance        Int                 @default(0)
  totalGranted   Int                 @default(0) @map("total_granted")
  totalConsumed  Int                 @default(0) @map("total_consumed")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries  CreditLedgerEntry[]

  @@map("credit_accounts")
}

model CreditLedgerEntry {
  id                    String         @id @default(cuid())
  userId                String         @map("user_id")
  accountId             String         @map("account_id")
  type                  String
  amount                Int
  balanceAfter          Int            @map("balance_after")
  reason                String?
  source                String?
  relatedConversationId String?        @map("related_conversation_id")
  relatedAgentRunId     String?        @map("related_agent_run_id")
  metadata              Json?
  createdAt             DateTime       @default(now()) @map("created_at")
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               CreditAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([type, createdAt])
  @@index([relatedConversationId])
  @@map("credit_ledger_entries")
}

model AgentUsageRecord {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  agentId               String   @map("agent_id")
  conversationId        String?  @map("conversation_id")
  agentRunId            String?  @map("agent_run_id")
  taskType              String   @map("task_type")
  estimatedCredits      Int      @map("estimated_credits")
  chargedCredits        Int      @default(0) @map("charged_credits")
  inputTokensEstimate   Int      @default(0) @map("input_tokens_estimate")
  outputTokensEstimate  Int      @default(0) @map("output_tokens_estimate")
  model                 String?
  toolCallCount         Int      @default(0) @map("tool_call_count")
  webSearchCount        Int      @default(0) @map("web_search_count")
  fileCount             Int      @default(0) @map("file_count")
  hasDeliverable        Boolean  @default(false) @map("has_deliverable")
  status                String   @default("charged")
  metadata              Json?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([conversationId, createdAt])
  @@index([agentRunId])
  @@index([status, createdAt])
  @@map("agent_usage_records")
}
